# Copy to .env and fill in. Every key is optional: `make demo` runs with none.

# GitHub REST/GraphQL. If unset, the collector falls back to `gh auth token`.
GITHUB_TOKEN=

# SEC EDGAR requires a descriptive User-Agent with a contact address.
SEC_USER_AGENT="FrontierRadar research (contact: you@example.com)"

# Semantic Scholar Graph API key (optional, raises the rate limit).
S2_API_KEY=

# Anthropic API (agents). Spend is hard-capped in code by LLM_SPEND_CAP_USD.
ANTHROPIC_API_KEY=
LLM_SPEND_CAP_USD=15

# Outputs
RESEND_API_KEY=
DIGEST_TO_EMAIL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
BLOB_READ_WRITE_TOKEN=

# Storage. Defaults to local SQLite at data/radar.db.
DATABASE_URL=

# Dashboard shared access code (middleware).
DASHBOARD_ACCESS_CODE=
